# ============================================================
#  Universal Campus Info Chatbot — Environment Configuration
# ============================================================

# -----------------------------------------------------------
# LLM Configuration (OpenAI)
# -----------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (gpt-4o-mini is fast and cost-effective)
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------
# LLM Configuration (Google Gemini — alternative provider)
# -----------------------------------------------------------
# Get your API key from: https://aistudio.google.com/apikey
# If both keys are set, OPENAI takes priority unless LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_google_api_key_here
# LLM_PROVIDER=gemini

# -----------------------------------------------------------
# App Configuration
# -----------------------------------------------------------
# Display name shown in the chatbot UI
COLLEGE_NAME=Universal Campus Assistant

# App theme (dark or light)
APP_THEME=dark

# Max chat history messages to retain in context
MAX_HISTORY=10

# -----------------------------------------------------------
# Vector Store
# -----------------------------------------------------------
# Path to store FAISS index (relative to project root)
VECTOR_STORE_PATH=./vector_store

# Embedding model (free, runs locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------
# Database
# -----------------------------------------------------------
DB_PATH=./campus.db

# -----------------------------------------------------------
# Web Scraping (optional — for live website scraping)
# -----------------------------------------------------------
# Add college website URLs to scrape (comma-separated)
# COLLEGE_URLS=https://example-college.ac.in,https://another-college.edu.in

# -----------------------------------------------------------
# Logging
# -----------------------------------------------------------
LOG_LEVEL=INFO
